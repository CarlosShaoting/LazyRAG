{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazymind.ai/contracts/workflow/v1/attempt-context.schema.json",
  "title": "Workflow Attempt Context v1",
  "type": "object",
  "required": ["contract_version", "session_id", "step_id", "attempt_id", "attempt_no", "operation", "input_bindings"],
  "properties": {
    "contract_version": {"const": "workflow.v1"},
    "session_id": {"type": "string", "minLength": 1},
    "step_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "attempt_no": {"type": "integer", "minimum": 1},
    "operation": {"enum": ["execute", "retry", "rewind"]},
    "runtime_instruction": {"type": "string"},
    "partial_selector": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "input_bindings": {
      "type": "array",
      "items": {
        "type": "object", "required": ["resource_id", "revision_id", "bind_as"],
        "properties": {
          "resource_id": {"type": "string", "minLength": 1},
          "revision_id": {"type": "string", "minLength": 1},
          "bind_as": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
